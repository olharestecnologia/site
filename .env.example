# Banco de dados (Postgres). Em produção, usar Vercel Postgres ou Neon.
# Para desenvolvimento local, subir Postgres via `docker-compose up -d`.
DATABASE_URL="postgresql://olhares:olhares@localhost:5432/olhares?schema=public"

# Vercel Blob — token criado no dashboard da Vercel (Storage → Blob)
BLOB_READ_WRITE_TOKEN=""

# Sessão admin — string aleatória com MIN. 32 caracteres
# Gerar: `openssl rand -base64 48`
SESSION_PASSWORD="troque-esta-string-por-uma-aleatoria-de-pelo-menos-32-chars"

# Gmail SMTP (usado pelo form de contato existente)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
CONTACT_TO_EMAIL=""
